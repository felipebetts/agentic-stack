# URL da API do agent (apps/agent). Embutida no bundle do navegador no build.
NEXT_PUBLIC_AGENT_URL=http://localhost:8000

# Better Auth. Mesmo Postgres do agent; as tabelas de auth ficam no schema `auth`.
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais
# URL pública deste app. Precisa ser igual ao AUTH_URL do agent.
BETTER_AUTH_URL=http://localhost:3000
