ENV=dev
LOG_LEVEL=INFO

# OpenRouter
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Restringe providers (útil p/ tool calling consistente). Formato JSON.
# OPENROUTER_PROVIDER_ORDER=["anthropic"]
APP_URL=http://localhost:3000
APP_NAME=meu-agente

# Postgres (o mesmo usado pelo Better Auth no web). Com pooler (PgBouncer, Supavisor etc.),
# use modo session: modo transaction quebra advisory locks e prepared statements.
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
DB_SCHEMA=agent

# Auth
# URL pública do app web (= BETTER_AUTH_URL). O JWT do Better Auth é validado contra
# o JWKS em {AUTH_URL}/api/auth/jwks e precisa ter iss/aud iguais a ela.
AUTH_URL=http://localhost:3000
# AUTH_JWKS_URL=   # sobrescreve só o endereço do JWKS (ex.: http://host.docker.internal:3000/api/auth/jwks)
SERVICE_API_KEYS=[]
# Só em ENV=dev: requisição SEM credencial vira o usuário dev-user (útil p/ curl e /docs).
# Tokens enviados continuam sendo validados.
AUTH_DISABLED=true

CORS_ORIGINS=["http://localhost:3000"]
RUN_TIMEOUT_SECONDS=300
RECURSION_LIMIT=25

# Observabilidade (opcional, requer extra "langfuse")
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
